# Poker server — example environment. Copy to .env for local runs.
# NEVER put real keys in this file or commit a real .env — the repo
# does not load .env at all (no dotenv dependency); Render reads its
# own Environment settings instead. Keys live in Render, never in git.

# Server
PORT=3000
HOST=127.0.0.1
CLIENT_URL=*

# Table bots (see bots/roster.js)
# BOTS_ENABLED=true
# BOT_TARGET=6

# LLM seats — one key per model. A seat whose key is missing plays
# the free heuristic brain instead, so the table still fills.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# Optional Twilio SMS alerts (server start + player join)
# SMS_ENABLED=false
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# ALERT_TO=
